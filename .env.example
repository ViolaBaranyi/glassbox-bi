# Minta a nyelvi réteghez (M4). Másold le `.env` néven, és töltsd ki — csak akkor kell, ha
# nem a configs/llm.toml szerinti helyi modellt (Ollama) használod.
# A `.env` SOHA nem kerül a tárolóba — a .gitignore kizárja.
# LLM_PROVIDER: ollama (helyi) vagy api (OpenAI-kompatibilis végpont)

LLM_PROVIDER=

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
