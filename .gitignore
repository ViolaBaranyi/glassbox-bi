# Adat soha nem megy a repóba — letöltő/generáló szkript van helyette.
data/raw/
data/*.duckdb

# Futásonkénti kimenetek
artifacts/
logs/*
# … kivéve a K1 mérések naplóit: a dolgozat nyelvi rétegre vonatkozó számai ezekből számolhatók újra
!logs/meres/

# Titkok (a nyelvi réteg kulcsai is ide kerülnek majd)
.env
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
# minden virtuális környezet (.venv, .venv-1, venv314 …)
.venv*/
venv*/
.pytest_cache/
.ipynb_checkpoints/

# IDE
.idea/
.vscode/

# Node.js (a PostgreSQL-ellenőrzés futtatója: tools/pg)
node_modules/

# a v3 nyelvi réteg külön munkamappája (tools/v3_futtatas.bat, git worktree)
v3_kod/
v4_kod/
